#!/usr/bin/env python3
"""Install missing project skills at their locked GitHub revisions."""
from collections import defaultdict
import json
import subprocess
from pathlib import Path
from tempfile import TemporaryDirectory
root = Path(__file__).resolve().parents[1]
locked_skills = json.loads((root / "skills-lock.json").read_text())["skills"]
skills_dir = root / ".agents/skills"
skills_dir.mkdir(parents=True, exist_ok=True)
missing = defaultdict(list)
for name, lock in locked_skills.items():
    target = skills_dir / name
    if (target / "SKILL.md").is_file():
        print(f"Already installed: {name}")
        continue
    if target.exists() or target.is_symlink():
        raise SystemExit(f"Incomplete skill directory: {target}")
    missing[lock["source"], lock["commit"]].append((Path(lock["skillPath"]), target))

for (source, commit), destinations in missing.items():
    with TemporaryDirectory(dir=skills_dir) as tmp:
        checkout = Path(tmp) / "checkout"
        subprocess.run(["git", "init", "--quiet", str(checkout)], check=True)
        git = ["git", "-C", str(checkout)]
        subprocess.run([*git, "fetch", "--quiet", "--depth=1", f"https://github.com/{source}.git", commit], check=True)
        subprocess.run([*git, "checkout", "--quiet", "--detach", commit], check=True)
        for skill_file, _ in destinations:
            if not (checkout / skill_file).is_file():
                raise SystemExit(f"Missing {skill_file} at {source}@{commit}")
        for skill_file, target in destinations:
            # Reserve the directory before installing so a second run cannot replace it.
            target.mkdir()
            try:
                (checkout / skill_file.parent).replace(target)
            except OSError:
                target.rmdir()
                raise
            print(f"Installed: {target.name}")
